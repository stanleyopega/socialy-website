<script>

function saveRecord(){

let name=document.getElementById("recordName").value;
let value=document.getElementById("recordValue").value;

if(name==="" || value===""){
alert("Fill all fields");
return;
}

let records=
JSON.parse(localStorage.getItem("records")) || [];

records.push({
name:name,
value:value
});

localStorage.setItem(
"records",
JSON.stringify(records)
);

displayRecords();

document.getElementById("recordName").value="";
document.getElementById("recordValue").value="";
}

function displayRecords(){

let records=
JSON.parse(localStorage.getItem("records")) || [];

let output="";

records.forEach((record,index)=>{

output+=`
<div class="record-item">
<strong>${record.name}</strong><br>
Amount: ${record.value}
</div>
`;

});

document.getElementById("recordList").innerHTML=
output;
}

function clearRecords(){

if(confirm("Delete all records?")){

localStorage.removeItem("records");

displayRecords();

}

}

function calculateProfit(){

let income=
Number(document.getElementById("income").value);

let expense=
Number(document.getElementById("expense").value);

let total=income-expense;

if(total>=0){

document.getElementById("result").innerHTML=
"Profit: "+total;

}else{

document.getElementById("result").innerHTML=
"Loss: "+Math.abs(total);

}

}

displayRecords();

document.getElementById("searchInput")
.addEventListener("keyup",function(){

let value=this.value.toLowerCase();

if(value.length>0){
console.log("Searching:",value);
}

});

</script>

